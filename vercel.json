{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/bridge.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/compiler", "destination": "/compiler/index.html" },
    {
      "source": "/api/:rute((?!bridge$).+)",
      "destination": "/api/[...rute]"
    }
  ],
  "regions": [
    "sin1"
  ]
}
