# Nama variabel konfigurasi server tab 6 (nilai TIDAK boleh ada di repo). Pengisi: INDRA (env Vercel / server Olympus).
DATABASE_URL=            # peran udt_app (SELECT/INSERT + UPDATE terbatas); pooled bila Neon
DATABASE_URL_UNPOOLED=   # peran udt_owner, hanya untuk `npm run migrate`
SESSION_SECRET=          # >= 32 karakter acak
APP_ENV=                 # prod | staging | dev (dev = cookie tanpa Secure untuk http lokal)
# F10: akun per pengguna ada di tabel app_user (migrasi 0005); TIDAK ada lagi kata sandi bersama di env.
# UDT_WRITER_PASSWORD_HASH / UDT_SHARED_PASSWORD_HASH / UDT_READER_PASSWORD_HASH dihapus (tidak dibaca lagi).
# Pengguna awal: node scripts/user_admin.mjs seed --file <daftar-lokal-INDRA> --out <berkas-di-luar-repo>  (lihat NOTES_F10.md)
