# Nama variabel konfigurasi server tab 6 (nilai TIDAK boleh ada di repo). Pengisi: INDRA (env Vercel / server Olympus).
DATABASE_URL=            # peran udt_app (hanya SELECT/INSERT + UPDATE terbatas); pooled bila Neon
DATABASE_URL_UNPOOLED=   # peran udt_owner, hanya untuk `npm run migrate`
SESSION_SECRET=          # >= 32 karakter acak
UDT_WRITER_PASSWORD_HASH=  # hasil hashPassword() di server/auth.js, format scrypt$N$r$p$salt$hash (beri tanda kutip tunggal di shell)
APP_ENV=                 # prod | staging | dev (dev = cookie tanpa Secure untuk http lokal)
UDT_READER_PASSWORD_HASH=  # peran pembaca (Compiler); kosong = hanya penulis yang bisa masuk
